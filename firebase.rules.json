{
  "rules": {
    ".read": false,
    ".write": false,
    "pins": {
      ".read": "auth != null",
      ".write": "root.child('admins/' + auth.uid).exists()"
    },
    "grants": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "db": {
      ".read": "auth != null",
      ".write": "root.child('admins/' + auth.uid).exists()"
    },
    "orders": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "history": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "fcmTokens": {
      ".read": "root.child('admins/' + auth.uid).exists()",
      "$deviceId": {
        ".write": "auth != null"
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "($uid === auth.uid && auth.token.firebase.sign_in_provider === 'password') || root.child('admins/' + auth.uid).exists()"
      }
    }
  }
}
